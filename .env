# Copy this file to .env and adjust as needed. No API keys required.

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
LLM_TEMPERATURE=0.1

# --- Embeddings (local Sentence Transformers) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5
FETCH_K=20
LAMBDA_MULT=0.5

# --- Storage ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=rag_documents

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=50

# --- Frontend ---
API_BASE_URL=http://localhost:8000
